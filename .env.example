# Supabase project skin-ai (awhulfitatettoqllejm).
# Put the real password only in .env. Do not commit .env.
SUPABASE_URL=https://awhulfitatettoqllejm.supabase.co
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.awhulfitatettoqllejm.supabase.co:5432/postgres?sslmode=require
NODE_ENV=development
PORT=3000
# Optional. Requests per minute per client IP.
# RATE_LIMIT_PER_MINUTE=120
# Optional. Comma-separated browser origins for CORS. The mobile app does not need it. Empty in production = CORS off.
# CORS_ORIGINS=https://admin.example.com
# Optional. PEM text of the database CA, so the database TLS certificate is verified.
# DATABASE_SSL_CA=

# Product recommendations. 'http' calls the AI service (docs/AI_SERVICE_CONTRACT.md), 'stub' uses the built-in
# stand-in that creates clearly marked test products (refused when NODE_ENV=production), 'off' uses Clara's own rules.
# Defaults to 'http' when AI_SERVICE_URL is set, otherwise 'off'.
# AI_SERVICE_MODE=stub
# AI_SERVICE_URL=https://ai.example.com
# Put the real key only in .env or the hosting settings. Do not commit it.
# AI_SERVICE_KEY=
# AI_TIMEOUT_MS=30000
# Added to the store price to get Clara's price, in percent.
# PRICE_MARKUP_PERCENT=8.5
