# Supabase project skin-ai-dev (iwfcfomrrsltczksyoaz), in the CA organization.
# Put the real password only in .env. Do not commit .env.
SUPABASE_URL=https://iwfcfomrrsltczksyoaz.supabase.co
# Public key (the app ships it too). Used by the password-reset page. Defaults to this project's key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_mc89QElgn31NiMWUX08kMw_4u1tdih2
# The API logs in as its own role clara_api (supabase/migrations/20261119120000_api_database_role.sql), through the
# transaction pooler. Set the password in the SQL editor: alter role clara_api with password '...';
# DATABASE_URL=postgresql://clara_api.iwfcfomrrsltczksyoaz:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# No sslmode in the URL: the API sets SSL itself (verified when DATABASE_SSL_CA holds Supabase's CA certificate).
NODE_ENV=development
PORT=3000
# Optional. Requests per minute per client IP.
# RATE_LIMIT_PER_MINUTE=120
# Optional. Comma-separated browser origins for CORS. The mobile app does not need it. Empty in production = CORS off.
# CORS_ORIGINS=https://admin.example.com
# Optional. PEM text of the database CA, so the database TLS certificate is verified.
# DATABASE_SSL_CA=

# Product recommendations. 'http' calls the AI service (docs/AI_SERVICE_CONTRACT.md), 'stub' uses the built-in
# stand-in that creates clearly marked test products (refused when NODE_ENV=production), 'off' uses Clara's own rules.
# Defaults to 'http' when AI_SERVICE_URL is set, otherwise 'off'.
# AI_SERVICE_MODE=stub
# AI_SERVICE_URL=https://ai.example.com
# Put the real key only in .env or the hosting settings. Do not commit it.
# AI_SERVICE_KEY=
# AI_TIMEOUT_MS=30000
# Added to the store price to get Clara's price, in percent.
# PRICE_MARKUP_PERCENT=8.5

# Checkout. Customers pay on Stripe Checkout (Stripe's own page); card details never reach Clara.
# Checkout stays off until both keys are set. Use test keys (sk_test_...) until real payments are wanted.
# Webhook endpoint to create in the Stripe dashboard: <PUBLIC_BASE_URL>/api/v1/payments/stripe/webhook
# with the events checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired.
# Put the real keys only in .env or the hosting settings. Do not commit them.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMENTS_MODE=stripe
# Public address of this API (Stripe sends the customer back here after paying).
# PUBLIC_BASE_URL=https://clara-skin-api.vercel.app

# --- Email (Resend) ---
# Order emails and the sign-up / password-reset emails go out through Resend. Without RESEND_API_KEY nothing is sent.
# EMAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Clara <hello@your-domain.com>
# EMAIL_REPLY_TO=support@your-domain.com
# Supabase > Authentication > Hooks > Send Email Hook (HTTPS) to <PUBLIC_BASE_URL>/api/v1/auth/email-hook; paste its secret here.
# SUPABASE_EMAIL_HOOK_SECRET=v1,whsec_...
